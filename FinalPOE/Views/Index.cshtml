@model IEnumerable< FinalPOE.Models.Module>

<h2>Module List</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ModuleId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Credits)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClassHoursPerWeek)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ModuleId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Credits)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ClassHoursPerWeek)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ModuleId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ModuleId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ModuleId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var today = DateTime.Today.DayOfWeek;

    // Fetch module scheduled for the current day
    var moduleScheduledForToday = Model.ModuleSchedule.FirstOrDefault(ms => ms.ScheduledDay == today);
}

@if (moduleScheduledForToday != null)
{
        <div>
            <h3>Today's Module:</h3>
            <p>@moduleScheduledForToday.Module.Name</p>
        </div>
}
else
{
        <p>No module scheduled for today.</p>
}
